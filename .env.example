# ---------------------------------------------------------------
# Client (Vite) — copy to client/.env.local only if you need to override
# ---------------------------------------------------------------
# Base URL of the API. Leave unset: the app calls /api on its own domain (in dev, Vite proxies it
# to wrangler dev on :8787). Only the no-custom-domain fallback in docs/DEPLOY.md sets a full URL.
# VITE_API_BASE=

# ---------------------------------------------------------------
# Server (Worker)
#   local:              server/.dev.vars (copy server/.dev.vars.example)
#   staging/production: plain settings in server/wrangler.toml under [env.staging] / [env.production];
#                       secrets with `npx wrangler secret put <NAME> --env <env>` — never committed.
# ---------------------------------------------------------------
# ENVIRONMENT=          development (local) | staging | production
# DEV_USER_EMAIL=       local only: who you are without Cloudflare Access (refused outside development)
# APP_URL=              public address of the app, for links in emails
# ACCESS_TEAM_DOMAIN=   <team>.cloudflareaccess.com            (staging/production)
# ACCESS_AUD=           Access application AUD tag              (staging/production)
# CORS_ORIGINS=         only for the no-custom-domain fallback
# ENCRYPTION_KEY=       secret: base64 of 32 random bytes (npm run gen:key)
# ENCRYPTION_KEY_PREVIOUS=  secret, only while rotating the key (docs/OPERATIONS.md)
# BREVO_API_KEY=        secret: Brevo transactional API key (empty locally = emails are logged)
