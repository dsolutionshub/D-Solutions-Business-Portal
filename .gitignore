# dependencies
node_modules/

# builds
dist/
*.tsbuildinfo

# Cloudflare local state (local D1/R2 data lives here)
.wrangler/

# secrets — never commit
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# reference prototype (demo build, not production code)
_prototype/

# editor / OS
.DS_Store
Thumbs.db
.idea/
*.log

